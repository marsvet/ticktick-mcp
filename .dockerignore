# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables (should be provided via -e or volume mount)
.env
.env.local
.env.*.local

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# OS specific files
.DS_Store
Thumbs.db
*.bak

# Git
.git/
.gitignore
.gitattributes

# Documentation (optional, can be included if needed)
# README.md
# *.md

# Test files (not needed in production image)
test_*.py
*_test.py
tests/

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Docker files (don't include Dockerfile itself in the image)
.dockerignore
